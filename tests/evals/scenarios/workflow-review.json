{
  "steps": [
    {
      "name": "unplugged merge",
      "block": false,
      "head": "head1",
      "state": "OPEN",
      "expected": "MERGE_REVIEW_REQUIRED",
      "fix": "cmdr workflow plug pr-review"
    },
    {
      "name": "unfinished review",
      "block": true,
      "head": "head1",
      "state": "OPEN",
      "expected": "MERGE_REVIEW_INCOMPLETE",
      "fix": "cmdr internal-close-objective --project p --bead S0"
    },
    {
      "name": "complete with evidence",
      "block": true,
      "complete": true,
      "head": "head1",
      "state": "OPEN",
      "expected": ""
    },
    {
      "name": "new push invalidates final check",
      "block": true,
      "complete": true,
      "head": "head2",
      "state": "OPEN",
      "expected": "MERGE_REVIEW_INCOMPLETE",
      "fix": "\"head\":\"<full-sha>\",\"fix_commits\":[\"<full-fix-sha>\"]}' ; cmdr internal-close-objective --project p --bead S1"
    },
    {
      "name": "later push still requires current-head evidence",
      "block": true,
      "complete": true,
      "head": "head3",
      "state": "OPEN",
      "expected": "MERGE_REVIEW_INCOMPLETE",
      "fix": "\"head\":\"<full-sha>\",\"fix_commits\":[\"<full-fix-sha>\"]}' ; cmdr internal-close-objective --project p --bead S1"
    },
    {
      "name": "merged historical PR",
      "block": false,
      "head": "head2",
      "state": "MERGED",
      "expected": ""
    },
    {
      "name": "closed historical target",
      "block": false,
      "closed": true,
      "head": "head2",
      "state": "OPEN",
      "expected": ""
    },
    {
      "name": "legacy unbound refuses completion and displays zero done",
      "block": true,
      "complete": true,
      "unbound": true,
      "head": "head1",
      "state": "OPEN",
      "expected": "MERGE_REVIEW_INCOMPLETE",
      "fix": "cmdr workflow bind-writers --project p --block R"
    },
    {
      "name": "writer binding change invalidates checks and display",
      "block": true,
      "complete": true,
      "rebound": true,
      "head": "head1",
      "state": "OPEN",
      "expected": "MERGE_REVIEW_INCOMPLETE",
      "fix": "cmdr internal-close-objective --project p --bead S0 ; cmdr internal-comment --project p --bead S1 --text",
