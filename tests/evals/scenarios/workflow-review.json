      "reason": "Stale: no check recorded for the current writer binding"
    },
    {
      "name": "changed revision renewal names the proof for the current binding",
      "block": true,
      "complete": true,
      "rebound": true,
      "head": "head1",
      "state": "OPEN",
      "expected": "MERGE_REVIEW_INCOMPLETE",
      "fix": "\"head\":\"<full-sha>\",\"fix_commits\":[\"<full-fix-sha>\"]}' ; cmdr internal-close-objective --project p --bead S1",
      "not_fix": "bind-writers"
    },
    {
      "name": "stale-head binding must be bound again",
      "block": true,
      "complete": true,
      "head": "head2",
      "state": "OPEN",
      "expected": "MERGE_REVIEW_INCOMPLETE",
      "fix": "cmdr workflow bind-writers --project p --block R"
    },
    {
      "name": "stale-head binding after a changed revision must be bound again",
      "block": true,
      "complete": true,
      "rebound": true,
      "head": "head2",
      "state": "OPEN",
      "expected": "MERGE_REVIEW_INCOMPLETE",
      "fix": "cmdr workflow bind-writers --project p --block R"
    },
    {
