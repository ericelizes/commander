{
  "schema": "external-writer-binding@v1",
  "runner": "cmd/cmdr:TestExternalWriterBindingScenario",
  "about": "A PR whose first commits came from the user's own sessions binds them as an external writer through the real `workflow bind-writers` CLI, then its review step closes with an independent review. A commit an Operator run wrote is never bound as the user's, and a reviewer task that wrote a bound commit is refused at the review close. Invented PR, SHAs and task ids.",
  "pr": {
    "head": "cccccccccccccccccccccccccccccccccccccccc",
    "commits": ["1111111111111111111111111111111111111111", "2222222222222222222222222222222222222222", "3333333333333333333333333333333333333333", "4444444444444444444444444444444444444444", "cccccccccccccccccccccccccccccccccccccccc"],
    "range": {"from": "base-sha", "to": "user-tip", "commits": ["2222222222222222222222222222222222222222", "1111111111111111111111111111111111111111"]},
    "op_range": {"from": "base-sha", "to": "op-tip", "commits": ["3333333333333333333333333333333333333333", "2222222222222222222222222222222222222222", "1111111111111111111111111111111111111111"]},
    "off_range": {"from": "base-sha", "to": "off-tip", "commits": ["9999999999999999999999999999999999999999", "1111111111111111111111111111111111111111"]}
  },
  "operator_commits": {"3333333333333333333333333333333333333333": "writer-task", "4444444444444444444444444444444444444444": "review-task"},
  "cases": [
    {"name": "manager binds the user's range", "role": "manager-B",
     "args": ["--external-writer", "user", "--commits", "base-sha..user-tip"],
     "exit": 0, "commits": ["1111111111111111111111111111111111111111", "2222222222222222222222222222222222222222"], "review_closes": true},
    {"name": "user CLI binds the user's commits and a fix task", "role": "",
     "args": ["--external-writer", "user", "--commits", "1111111111111111111111111111111111111111", "--writers", "fix-task"],
     "exit": 0, "commits": ["1111111111111111111111111111111111111111"], "tasks": ["fix-task"], "review_closes": true},
    {"name": "commander binds the user's commits", "role": "commander",
     "args": ["--external-writer", "user", "--commits", "2222222222222222222222222222222222222222"],
     "exit": 0, "commits": ["2222222222222222222222222222222222222222"], "review_closes": true},
    {"name": "an Operator's commit in the range refused as the user's", "role": "manager-B",
     "args": ["--external-writer", "user", "--commits", "base-sha..op-tip"],
     "exit": 1, "stderr": "is not the user's own"},
    {"name": "an Operator's commit in a list refused as the user's", "role": "",
     "args": ["--external-writer", "user", "--commits", "1111111111111111111111111111111111111111,3333333333333333333333333333333333333333"],
     "exit": 1, "stderr": "is not the user's own"},
    {"name": "reviewer task that wrote a bound commit refused", "role": "manager-B", "hidden_at_bind": true,
     "args": ["--external-writer", "user", "--commits", "4444444444444444444444444444444444444444"],
     "exit": 0, "commits": ["4444444444444444444444444444444444444444"], "review_refused": "differ from the writer of bound external commit"},
    {"name": "operator refused", "role": "operator-fix", "manager": "manager-B",
     "args": ["--external-writer", "user", "--commits", "base-sha..user-tip"],
     "exit": 1, "stderr": "writer selection belongs"},
    {"name": "foreign manager refused", "role": "manager-other",
     "args": ["--external-writer", "user", "--commits", "base-sha..user-tip"],
     "exit": 1, "stderr": "writer selection belongs"},
    {"name": "commit off the PR refused", "role": "manager-B",
     "args": ["--external-writer", "user", "--commits", "9999999999999999999999999999999999999999"],
     "exit": 1, "stderr": "not on the PR"},
    {"name": "range resolving to a commit off the PR refused", "role": "manager-B",
     "args": ["--external-writer", "user", "--commits", "base-sha..off-tip"],
     "exit": 1, "stderr": "not on the PR"},
    {"name": "commits without the external writer refused", "role": "manager-B",
     "args": ["--writers", "fix-task", "--commits", "1111111111111111111111111111111111111111"],
     "exit": 1, "stderr": "required:"},
    {"name": "external writer without commits refused", "role": "manager-B",
     "args": ["--external-writer", "user"],
     "exit": 1, "stderr": "required:"}
  ]
}
