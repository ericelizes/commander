{
  "schema": "review-minor-policy@v1",
  "runner": "cmd/cmdr:TestReviewMinorPolicyScenario",
  "about": "Minor findings (d78) through the real close door on a block plugged from pr-review version 1: blockers and majors still block; minors left on the passing head become Manager-held follow-ups and the step passes; a review of only a delta never stands as full coverage. Shas are symbolic (h1, h2, fix, pr-base).",
  "rounds": [
    {
      "name": "primary review leaves two minors, no fix required",
      "step": 1,
      "head": "h1",
      "review": "review-1",
      "base": "pr-base",
      "findings": [
        {
          "id": "m1",
          "severity": "minor",
          "summary": "rename a helper"
        },
        {
          "id": "m2",
          "severity": "minor",
          "summary": "tighten a comment"
        }
      ],
      "proof": {
        "no_fix_required": true
      },
      "want": "pass",
      "follow_ups": 2
    },
    {
      "name": "a retried close files no follow-up twice",
      "step": 1,
      "retry": true,
      "want": "pass",
      "follow_ups": 2
    },
    {
      "name": "no_findings cannot hide typed minors",
      "step": 2,
      "head": "h2",
      "review": "review-hide",
      "base": "pr-base",
      "findings": [
        {
          "id": "m9",
          "severity": "minor",
          "summary": "hidden nit"
        }
      ],
      "proof": {
        "no_findings": true,
        "fix_commits": []
      },
      "want": "contradicts",
      "follow_ups": 2
    },
    {
      "name": "a review of only the fix delta is no full coverage",
      "step": 2,
      "head": "h2",
      "review": "review-delta",
      "base": "h1",
      "proof": {
        "fix_commits": [
          "fix"
        ]
      },
      "want": "reviewed only the delta",
      "follow_ups": 2
    },
    {
      "name": "a major on the second review still blocks",
      "step": 2,
      "head": "h2",
      "review": "review-major",
      "base": "pr-base",
      "findings": [
        {
          "id": "x1",
          "severity": "major",
          "summary": "a real bug"
        }
      ],
      "proof": {
        "fix_commits": [
          "fix"
        ]
      },
      "want": "source findings",
      "follow_ups": 2
    },
    {
      "name": "one fix pass, the review finds a new minor: filed, step passes",
      "step": 2,
      "head": "h2",
      "review": "review-2",
      "base": "pr-base",
      "findings": [
        {
          "id": "m3",
          "severity": "minor",
          "summary": "a further nit"
        }
      ],
      "proof": {
        "fix_commits": [
          "fix"
        ]
      },
      "want": "pass",
      "follow_ups": 3
    }
  ]
}
