{
  "name": "commander-app",
  "productName": "Commander",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop cockpit for Commander: a thin Electron client over cmdrd",
  "author": "Commander contributors",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "dev:web": "electron-vite dev --rendererOnly",
    "dev:renderer": "vite --config vite.renderer.config.mts",
    "build": "electron-vite build",
    "start": "electron-vite build && electron .",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "shots": "node scripts/shots.mjs",
    "smoke:offline": "electron-vite build && node scripts/smoke.mjs --offline",
    "smoke:electron": "electron-vite build && electron . --smoke",
    "smoke:inspector": "node electron/inspector/smoke/run.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:layout": "node scripts/layout-check.mjs",
    "pack": "npm run build && electron-builder --config build/electron-builder.yml --dir",
    "dist": "npm run build && electron-builder --config build/electron-builder.yml",
    "install-app": "../scripts/app-install.sh",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.25",
    "@tanstack/react-virtual": "3.14.21",
    "html-to-image": "^1.11.13",
    "lucide-react": "1.52.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tldts": "7.4.19",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.2",
    "electron-builder": "26.15.7",
    "electron-vite": "6.0.0",
    "esbuild": "0.27.7",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
